<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Mp3PlayerSync.LoadingIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  The one look for every loading state in the app  -->
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="20">
        <ProgressRing
            x:Name="Ring"
            Width="56"
            Height="56"
            IsActive="True" />
        <TextBlock
            x:Name="Label"
            FontSize="20"
            HorizontalTextAlignment="Center"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
