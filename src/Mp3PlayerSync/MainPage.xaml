<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mp3PlayerSync.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Mp3PlayerSync.Core"
    xmlns:local="using:Mp3PlayerSync"
    xmlns:sync="using:Mp3PlayerSync.Sync"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Room for the name and three lines of details under each cover; keeps the covers square  -->
        <x:Double x:Key="TileTextHeight">90</x:Double>

        <!--  The track list's header and rows share this padding, so their columns line up; the left edge lines up with the cover above  -->
        <Thickness x:Key="TrackRowPadding">32,0,16,0</Thickness>

        <!--  Page banners sit directly on the window's Mica  -->
        <Style x:Key="BannerStyle" TargetType="StackPanel">
            <Setter Property="Padding" Value="48,40,48,24" />
            <Setter Property="Spacing" Value="16" />
        </Style>
        <!--  The back arrow and the banner under it sit at the same place on every page, so switching pages only changes
              the text. The e2e checks this from rendered pixels.  -->
        <Style
            x:Key="HeadingBackButtonStyle"
            BasedOn="{StaticResource NavigationBackButtonNormalStyle}"
            TargetType="Button">
            <!--  The arrow glyph sits high in its button; this lines it up with the heading's capitals  -->
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="BannerUnderHeadingStyle"
            BasedOn="{StaticResource BannerStyle}"
            TargetType="StackPanel">
            <Setter Property="Padding" Value="48,12,48,24" />
        </Style>        <Style
            x:Key="BannerTitleStyle"
            BasedOn="{StaticResource TitleLargeTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
        </Style>
        <Style x:Key="BannerTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="LineHeight" Value="34" />
            <Setter Property="MaxWidth" Value="900" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="MessageBar"
            Margin="16,0,16,8"
            IsClosable="True" />

        <Grid Grid.Row="1">
            <!--  Spotify's sign-in page (through Exportify) and its header, which are only ever shown together.
                  Collapsed otherwise, with the WebView2 kept alive for automation.  -->
            <Grid x:Name="SignInView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Style="{StaticResource BannerStyle}">
                    <TextBlock
                        AutomationProperties.AutomationId="SignInTitle"
                        Style="{StaticResource BannerTitleStyle}"
                        Text="Sign in to Spotify" />
                    <TextBlock
                        AutomationProperties.AutomationId="SignInText"
                        Style="{StaticResource BannerTextStyle}"
                        Text="Sign in with your Spotify account so MP3 Player Sync can sync your playlists." />
                </StackPanel>

                <!--  Shown only while Spotify's own pages are loaded; never anything else  -->
                <WebView2
                    x:Name="ExportifyWebView"
                    Grid.Row="1"
                    AutomationProperties.Name="Spotify sign-in" />

                <StackPanel
                    x:Name="SignInPrompt"
                    Grid.Row="1"
                    Padding="48,0"
                    Visibility="Collapsed">
                    <Button
                        x:Name="SignInPromptButton"
                        Padding="20,8"
                        AutomationProperties.AutomationId="SignInPromptButton"
                        Click="OnSignInPromptClick"
                        Content="Continue to Spotify"
                        FontSize="16"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <!--  Shown until the app knows whether the user is signed in  -->
            <local:LoadingIndicator
                x:Name="LoadingView"
                TextAutomationId="LoadingText"
                Visibility="Collapsed" />

            <!--  First page, every time: choose the MP3 player  -->
            <Grid x:Name="PlayerView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Style="{StaticResource BannerStyle}">
                    <TextBlock
                        AutomationProperties.AutomationId="PlayerTitle"
                        Style="{StaticResource BannerTitleStyle}"
                        Text="Select an MP3 player to sync" />
                    <TextBlock
                        AutomationProperties.AutomationId="PlayerText"
                        Style="{StaticResource BannerTextStyle}"
                        Text="Connect your MP3 player or memory card. It will appear here as a drive." />
                </StackPanel>

                <GridView
                    x:Name="PlayerGridView"
                    Grid.Row="1"
                    Padding="36,0,36,24"
                    AutomationProperties.AutomationId="PlayerGridView"
                    AutomationProperties.Name="MP3 players"
                    IsItemClickEnabled="True"
                    ItemClick="OnPlayerItemClick"
                    SelectionMode="Single">
                    <GridView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                            <Setter Property="Margin" Value="4" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="core:PlayerOption">
                            <Grid
                                Width="220"
                                Height="190"
                                Padding="16"
                                RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <FontIcon
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="56"
                                    Glyph="{x:Bind Glyph}" />
                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ShortSubtitle}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{x:Bind SubtitleToolTip}" />
                                    <ProgressBar
                                        Margin="0,6,0,2"
                                        AutomationProperties.Name="Space used"
                                        Foreground="{x:Bind local:LibraryVisuals.UsageForeground(IsNearlyFull)}"
                                        Maximum="1"
                                        MinHeight="6"
                                        Value="{x:Bind UsedFraction}"
                                        Visibility="{x:Bind ShowsUsage}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Visibility="{x:Bind local:LibraryVisuals.VisibleIfAny(Detail)}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <Grid x:Name="NativePanel" Visibility="Collapsed">

                <!--  Library page: choose a playlist or album  -->
                <Grid x:Name="LibraryView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="LibraryHeadingRow" Margin="16,0,16,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                                                <Button
                            x:Name="ChangePlayerButton"
                            AutomationProperties.AutomationId="ChangePlayerButton"
                            AutomationProperties.Name="Back to MP3 players"
                            Click="OnChangePlayerClick"
                            Style="{StaticResource HeadingBackButtonStyle}"
                            ToolTipService.ToolTip="Back to MP3 players" />

                        <local:PlayerDisplay
                            x:Name="SelectedPlayer"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="SelectedPlayerPanel"
                            NameAutomationId="SelectedPlayerTitle" />
                    </Grid>

                    <StackPanel Grid.Row="1" Style="{StaticResource BannerUnderHeadingStyle}">
                        <TextBlock
                            AutomationProperties.AutomationId="LibraryTitle"
                            Style="{StaticResource BannerTitleStyle}"
                            Text="Select a playlist to sync" />
                    </StackPanel>

                    <!--  The window's minimum width keeps this row on one line; see RequireToolbarWidth  -->
                    <Grid
                        x:Name="LibraryToolbar"
                        Grid.Row="2"
                        Margin="36,16,36,0"
                        ColumnSpacing="8"
                        SizeChanged="OnLibraryToolbarSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <SelectorBar
                            x:Name="FilterBar"
                            AutomationProperties.AutomationId="FilterBar"
                            SelectionChanged="OnFilterChanged">
                            <SelectorBarItem x:Name="ByYouFilterItem" Text="Playlists by you" />
                            <SelectorBarItem x:Name="ByOthersFilterItem" Text="Playlists by others" />
                            <SelectorBarItem x:Name="SavedAlbumsFilterItem" Text="Saved albums" />
                            <SelectorBarItem x:Name="AllFilterItem" Text="All" />
                        </SelectorBar>

                        <Button
                            x:Name="RefreshLibraryButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="RefreshLibraryButton"
                            AutomationProperties.Name="Refresh playlists"
                            Click="OnRefreshLibraryClick"
                            ToolTipService.ToolTip="Reload your playlists and albums">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="SignOutButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="SignOutButton"
                            Click="OnSignOutClick"
                            Content="Sign out of Spotify" />
                    </Grid>

                    <TextBlock
                        x:Name="LibrarySummaryText"
                        Grid.Row="3"
                        Margin="48,8,48,8"
                        AutomationProperties.AutomationId="LibrarySummaryText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <GridView
                        x:Name="LibraryGridView"
                        Grid.Row="4"
                        Padding="36,0,36,24"
                        AutomationProperties.AutomationId="LibraryGridView"
                        AutomationProperties.Name="Playlists and albums"
                        IsItemClickEnabled="True"
                        ItemClick="OnLibraryItemClick"
                        SelectionMode="Single"
                        SizeChanged="OnLibraryGridSizeChanged">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="core:LibraryItem">
                                <Grid Padding="8" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Background="{x:Bind local:LibraryVisuals.TileBackground(Kind)}" CornerRadius="6">
                                        <FontIcon
                                            FontSize="48"
                                            Foreground="{x:Bind local:LibraryVisuals.GlyphForeground(Kind)}"
                                            Glyph="{x:Bind Glyph}" />
                                        <Image Source="{x:Bind local:LibraryVisuals.Cover(CoverUrl)}" Stretch="UniformToFill" />
                                    </Grid>

                                    <StackPanel
                                        Grid.Row="1"
                                        Height="{StaticResource TileTextHeight}"
                                        Spacing="2">
                                        <TextBlock
                                            FontSize="18"
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Byline}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            Visibility="{x:Bind local:LibraryVisuals.VisibleIfAny(Byline)}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Stats}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            Visibility="{x:Bind local:LibraryVisuals.VisibleIfAny(Stats)}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DateText}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            Visibility="{x:Bind local:LibraryVisuals.VisibleIfAny(DateText)}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <local:LoadingIndicator
                        x:Name="LibraryBusy"
                        Grid.Row="3"
                        Grid.RowSpan="2"
                        TextAutomationId="LibraryBusyText"
                        Visibility="Collapsed" />
                </Grid>
                <!--  Playlist page: the contents of one playlist or album  -->
                <Grid
                    x:Name="PlaylistView"
                    Padding="16,0,16,16"
                    SizeChanged="OnPlaylistViewSizeChanged"
                    RowSpacing="8"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  "← Spotify playlist: [cover] name" on the left, and the player it syncs to on the right. One line, the same
                          height as the playlists page's heading.  -->
                    <Grid
                        x:Name="PlaylistHeadingRow"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BackButton"
                            AutomationProperties.AutomationId="BackButton"
                            AutomationProperties.Name="Back to playlists"
                            Click="OnBackClick"
                            Style="{StaticResource HeadingBackButtonStyle}"
                            ToolTipService.ToolTip="Back to playlists" />

                        <!--  Separate text blocks around the cover, in the same style as "Player: [icon] name", so the line's
                              height never depends on the cover and the arrow stays centered on the capitals  -->
                        <Grid
                            x:Name="PlaylistHeading"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="PlaylistKindText"
                                AutomationProperties.AccessibilityView="Raw"
                                Style="{StaticResource HeadingTextStyle}" />
                            <Grid
                                x:Name="TitleCover"
                                Grid.Column="1"
                                Width="24"
                                Height="24"
                                Margin="10,0,10,0"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                CornerRadius="4">
                                <FontIcon x:Name="TitleCoverGlyph" FontSize="12" />
                                <Image x:Name="TitleCoverImage" Stretch="UniformToFill" />
                            </Grid>
                            <TextBlock
                                x:Name="PlaylistTitle"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="PlaylistTitle"
                                Style="{StaticResource HeadingTextStyle}" />
                        </Grid>

                        <local:PlayerDisplay
                            x:Name="ContentsPlayer"
                            Grid.Column="2"
                            Margin="24,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ContentsPlayerPanel"
                            NameAutomationId="ContentsPlayerText"
                            ShortensPath="True" />
                    </Grid>

                    <!--  The negative margin undoes this page's padding and row spacing, so the banner sits exactly where the
                          playlists page's does. Open folder shares the banner's line, so it adds no height; when the player
                          doesn't fit beside the heading, it goes under the title here, so the banner never moves.  -->
                    <StackPanel
                        x:Name="ContentsBanner"
                        Grid.Row="1"
                        Margin="-16,-8,-16,0"
                        Style="{StaticResource BannerUnderHeadingStyle}">
                        <Grid x:Name="ContentsBannerTitleRow" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                AutomationProperties.AutomationId="ContentsBannerTitle"
                                Style="{StaticResource BannerTitleStyle}"
                                Text="Choose songs to sync" />
                            <!--  Just under the player's line, right-aligned with it: the negative margins reach up into the heading
                                  row's spare space and out into the page's padding, without changing anything's height  -->
                            <Button
                                x:Name="OpenPlayerFolderButton"
                                Grid.Column="1"
                                Margin="0,-20,-32,0"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="OpenPlayerFolderButton"
                                Click="OnOpenPlayerFolderClick"
                                ToolTipService.ToolTip="Show this playlist's songs on the player in File Explorer">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                                    <TextBlock Text="Open folder" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--  What's in the playlist, and what syncing the checked songs would change  -->
                    <Grid
                        x:Name="PlaylistInfoBar"
                        Grid.Row="2"
                        Padding="{StaticResource TrackRowPadding}"
                        ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="16">
                            <TextBlock
                                x:Name="SummaryText"
                                AutomationProperties.AutomationId="SummaryText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                x:Name="CheckingPlayerPanel"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="Collapsed">
                                <ProgressRing
                                    Width="12"
                                    Height="12"
                                    IsActive="True" />
                                <TextBlock
                                    AutomationProperties.AutomationId="CheckingPlayerText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Checking player…" />
                            </StackPanel>
                            <!--  How many of the songs being looked for in the background have been found  -->
                            <StackPanel
                                x:Name="FindingPanel"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="Collapsed">
                                <ProgressRing
                                    Width="12"
                                    Height="12"
                                    IsActive="True" />
                                <TextBlock
                                    x:Name="FindingProgressText"
                                    AutomationProperties.AutomationId="FindingProgressText"
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <!--  Why syncing can't start: a locked card, or not enough space  -->
                            <StackPanel
                                x:Name="PlayerProblemPanel"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="Collapsed">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xE7BA;" />
                                <TextBlock
                                    x:Name="PlayerProblemText"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="PlayerProblemText"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <Button
                            x:Name="RefreshPlaylistButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="RefreshPlaylistButton"
                            AutomationProperties.Name="Refresh this playlist"
                            Click="OnRefreshPlaylistClick"
                            ToolTipService.ToolTip="Reload this playlist">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="ReviewMatchesButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ReviewMatchesButton"
                            Click="OnReviewMatchesClick"
                            ToolTipService.ToolTip="Choose the right match for songs that weren't found for certain"
                            Visibility="Collapsed" />

                        <TextBlock
                            x:Name="SyncSummaryText"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="SyncSummaryText"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <!--  How far the sync has got  -->
                        <StackPanel
                            x:Name="SyncProgressPanel"
                            Grid.Column="3"
                            Width="220"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="SyncProgressText"
                                AutomationProperties.AutomationId="SyncProgressText"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ProgressBar
                                x:Name="SyncProgressBar"
                                AutomationProperties.AutomationId="SyncProgressBar"
                                AutomationProperties.Name="Sync progress"
                                Maximum="1" />
                        </StackPanel>

                        <Button
                            x:Name="SyncButton"
                            Grid.Column="4"
                            Padding="20,8"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="SyncButton"
                            Click="OnSyncClick"
                            FontSize="16"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon
                                    x:Name="SyncButtonGlyph"
                                    FontSize="16"
                                    Glyph="&#xE895;" />
                                <TextBlock x:Name="SyncButtonText" Text="Sync to player" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  The header and the rows share their column widths, and their padding matches the list items'  -->
                    <Grid
                        x:Name="TrackHeader"
                        Grid.Row="3"
                        Padding="{StaticResource TrackRowPadding}"
                        ColumnSpacing="12"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Number, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Title, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Artists, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Album, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Time, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Added, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Status, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Remove, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            x:Name="SelectAllCheckBox"
                            MinWidth="0"
                            Padding="0"
                            AutomationProperties.AutomationId="SelectAllCheckBox"
                            AutomationProperties.Name="Select all tracks"
                            Click="OnSelectAllClick"
                            IsThreeState="True" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.AutomationId="NumberHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Text="#" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" AutomationProperties.AutomationId="TitleHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Title" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" AutomationProperties.AutomationId="ArtistsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Artists" />
                        <TextBlock x:Name="AlbumHeader" Grid.Column="4" VerticalAlignment="Center" AutomationProperties.AutomationId="AlbumHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Album" />
                        <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.AutomationId="TimeHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Time" />
                        <TextBlock Grid.Column="6" VerticalAlignment="Center" AutomationProperties.AutomationId="AddedHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Added" />
                        <TextBlock x:Name="StatusHeader" Grid.Column="7" VerticalAlignment="Center" AutomationProperties.AutomationId="StatusHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Status" />
                        <TextBlock
                            x:Name="RemoveHeader"
                            Grid.Column="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="RemoveHeader"
                            AutomationProperties.Name="Remove from player"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Text="&#xE74D;"
                            ToolTipService.ToolTip="Remove from player"
                            Visibility="Collapsed" />
                    </Grid>

                    <ListView
                        x:Name="TracksListView"
                        Grid.Row="4"
                        AutomationProperties.AutomationId="TracksListView"
                        AutomationProperties.Name="Tracks"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="{StaticResource TrackRowPadding}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="sync:TrackRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Number, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Title, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Artists, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Album, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Time, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Added, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Status, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind sync:TrackColumns.Shared.Remove, Mode=OneWay}" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        MinWidth="0"
                                        Padding="0"
                                        AutomationProperties.Name="{x:Bind Title}"
                                        Click="OnTrackCheckBoxClick"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                        IsEnabled="{x:Bind CanCheck, Mode=OneWay}"
                                        Visibility="{x:Bind IsSpotifyTrack}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Number}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontStyle="{x:Bind local:LibraryVisuals.ItalicIf(IsPlayerOnly)}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontStyle="{x:Bind local:LibraryVisuals.ItalicIf(IsPlayerOnly)}" Text="{x:Bind ArtistsText}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ArtistsText}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" FontStyle="{x:Bind local:LibraryVisuals.ItalicIf(IsPlayerOnly)}" Text="{x:Bind Album}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Album}" Visibility="{x:Bind sync:TrackColumns.Shared.ShowsAlbum, Mode=OneWay}" />
                                    <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind DurationText}" />
                                    <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{x:Bind AddedAtText}" TextTrimming="CharacterEllipsis" />
                                    <!--  Left-aligned with a star column: the status keeps to its own width, trims when there's no room, and Undo follows it.
                                          The icon's slot is always there so that every status's text lines up; the text alone carries the meaning.  -->
                                    <Grid Grid.Column="7" HorizontalAlignment="Left" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Glyph="&#xE73E;"
                                            Visibility="{x:Bind IsSuccessStatus, Mode=OneWay}" />
                                        <FontIcon
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;"
                                            Visibility="{x:Bind IsCautionStatus, Mode=OneWay}" />
                                        <FontIcon
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Glyph="&#xEA39;"
                                            Visibility="{x:Bind IsCriticalStatus, Mode=OneWay}" />
                                        <FontIcon
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemFillColorNeutralBrush}"
                                            Glyph="&#xE733;"
                                            Visibility="{x:Bind IsNeutralStatus, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Status, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}" />
                                        <HyperlinkButton
                                            Grid.Column="2"
                                            Padding="4,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind local:LibraryVisuals.UndoSkipLabel(Title)}"
                                            Click="OnUndoSkipClick"
                                            Content="Undo"
                                            Visibility="{x:Bind CanUndoSkip, Mode=OneWay}" />
                                    </Grid>
                                    <CheckBox
                                        Grid.Column="8"
                                        MinWidth="0"
                                        HorizontalAlignment="Center"
                                        Padding="0"
                                        AutomationProperties.Name="{x:Bind local:LibraryVisuals.RemoveLabel(Title)}"
                                        Click="OnTrackCheckBoxClick"
                                        IsChecked="{x:Bind IsMarkedForRemoval, Mode=TwoWay}"
                                        IsEnabled="{x:Bind CanChange, Mode=OneWay}"
                                        Visibility="{x:Bind IsPlayerOnly}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!--  Settling uncertain matches before anything is downloaded  -->
                    <Grid
                        x:Name="ReviewPanel"
                        Grid.Row="3"
                        Grid.RowSpan="2"
                        RowSpacing="8"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="{StaticResource TrackRowPadding}" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    x:Name="ReviewTitle"
                                    AutomationProperties.AutomationId="ReviewTitle"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Pick a result, paste a link to the song on YouTube or YouTube Music, or skip the song."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="ReviewCancelButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ReviewCancelButton"
                                Click="OnReviewCancelClick"
                                Content="Cancel" />
                            <Button
                                x:Name="ReviewContinueButton"
                                Grid.Column="2"
                                Padding="20,6"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ReviewContinueButton"
                                Click="OnReviewContinueClick"
                                Content="Continue"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>

                        <ListView
                            x:Name="ReviewListView"
                            Grid.Row="1"
                            AutomationProperties.AutomationId="ReviewListView"
                            AutomationProperties.Name="Songs to review"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="{StaticResource TrackRowPadding}" />
                                    <Setter Property="Margin" Value="0,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="sync:ReviewItem">
                                    <Border
                                        Padding="16,12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Details}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Reason, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{x:Bind IsOpen, Mode=OneWay}" />
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{x:Bind Candidates}" Visibility="{x:Bind HasCandidates, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="sync:ReviewCandidate">
                                                        <Grid Padding="0,4" ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind Details}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind Problem}"
                                                                    TextWrapping="Wrap"
                                                                    Visibility="{x:Bind local:LibraryVisuals.VisibleIfAny(Problem)}" />
                                                            </StackPanel>
                                                            <HyperlinkButton
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.Name="{x:Bind OpenLabel}"
                                                                Content="Open"
                                                                NavigateUri="{x:Bind Link}"
                                                                ToolTipService.ToolTip="Listen on YouTube Music" />
                                                            <Button
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.Name="{x:Bind UseLabel}"
                                                                Click="OnUseCandidateClick"
                                                                Content="Use this"
                                                                IsEnabled="{x:Bind CanUse}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Spacing="4" Visibility="{x:Bind IsOpen, Mode=OneWay}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox
                                                        AutomationProperties.Name="{x:Bind LinkLabel}"
                                                        PlaceholderText="Paste a link to the song"
                                                        Text="{x:Bind PastedLink, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        AutomationProperties.Name="{x:Bind UseLinkLabel}"
                                                        Click="OnUseLinkClick"
                                                        Content="Use link" />
                                                </Grid>
                                                <TextBlock
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Text="{x:Bind LinkError, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{x:Bind HasLinkError, Mode=OneWay}" />
                                                <StackPanel
                                                    Margin="0,4,0,0"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <Button
                                                        AutomationProperties.Name="{x:Bind RetryLabel}"
                                                        Click="OnRetryLookupClick"
                                                        Content="Try again"
                                                        Visibility="{x:Bind CanRetry, Mode=OneWay}" />
                                                    <Button
                                                        AutomationProperties.Name="{x:Bind SkipLabel}"
                                                        Click="OnSkipReviewClick"
                                                        Content="Skip" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Visibility="{x:Bind IsWorking, Mode=OneWay}">
                                                <ProgressRing
                                                    Width="16"
                                                    Height="16"
                                                    IsActive="{x:Bind IsWorking, Mode=OneWay}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Checking…" />
                                            </StackPanel>

                                            <Grid ColumnSpacing="8" Visibility="{x:Bind IsSettled, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    Glyph="&#xE73E;"
                                                    Visibility="{x:Bind IsChosen, Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind SettledText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    Grid.Column="2"
                                                    AutomationProperties.Name="{x:Bind ChangeLabel, Mode=OneWay}"
                                                    Click="OnChangeReviewClick"
                                                    Content="{x:Bind ChangeText, Mode=OneWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!--  When the playlist couldn't be loaded  -->
                    <StackPanel
                        x:Name="LoadFailedPanel"
                        Grid.Row="3"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="Collapsed">
                        <TextBlock
                            HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="LoadFailedText"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Couldn't load this playlist." />
                        <Button
                            x:Name="TryAgainButton"
                            HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="TryAgainButton"
                            Click="OnRefreshPlaylistClick"
                            Content="Try again"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <local:LoadingIndicator
                        x:Name="PlaylistBusy"
                        Grid.Row="2"
                        Grid.RowSpan="3"
                        TextAutomationId="PlaylistBusyText"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
