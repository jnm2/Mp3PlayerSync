<Project Sdk="Microsoft.NET.Sdk">

  <!-- Temporary, while the unit tests move to TUnit: runs the ones in ..\Mp3PlayerSync.Tests that are still NUnit, listed
       in StillNUnit.props, where they are. Microsoft.Testing.Platform runs one test framework per test app. -->

  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The name Mp3PlayerSync.Core's InternalsVisibleTo gives -->
    <AssemblyName>Mp3PlayerSync.Tests</AssemblyName>
    <RootNamespace>Mp3PlayerSync.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>

  <Import Project="StillNUnit.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.6.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="@(StillNUnit)" />
    <None Include="$(UnitTestsFolder)Tagging\Assets\**" Link="Tagging\Assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mp3PlayerSync.Core\Mp3PlayerSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Mp3PlayerSync\WindowsAlbumArtConverter.cs" Link="Tagging\WindowsAlbumArtConverter.cs" />
    <Compile Include="..\..\src\Mp3PlayerSync\LaunchHandOver.cs" Link="LaunchHandOver.cs" />
    <Compile Include="..\..\src\Mp3PlayerSync\VolumeChangeFilter.cs" Link="VolumeChangeFilter.cs" />
    <Compile Include="..\..\src\Mp3PlayerSync\RerunningCheck.cs" Link="RerunningCheck.cs" />
    <Compile Include="..\..\src\Mp3PlayerSync\HostNavigations.cs" Link="HostNavigations.cs" />
  </ItemGroup>

</Project>
