<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows, for the demo covers, which System.Drawing draws -->
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The mock's pages, served from beside the exe -->
    <Content Include="..\MockExportify\**" LinkBase="MockExportify" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
