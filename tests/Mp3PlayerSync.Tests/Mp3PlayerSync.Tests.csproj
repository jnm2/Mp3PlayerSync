<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows, for the app's cover art converter, which uses Windows' imaging (linked below) -->
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- TUnit runs on Microsoft.Testing.Platform, global.json's test runner, and brings its TRX and code coverage -->
    <OutputType>Exe</OutputType>
    <!-- The tests assert with Shouldly, which isn't awaited, rather than TUnit's assertions -->
    <TUnitAssertionsImplicitUsings>false</TUnitAssertionsImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.6.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="TUnit" Version="1.84.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Tagging\Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mp3PlayerSync.Core\Mp3PlayerSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app itself is a WinUI exe, which this can't reference -->
    <Compile Include="..\..\src\Mp3PlayerSync\WindowsAlbumArtConverter.cs" Link="Tagging\WindowsAlbumArtConverter.cs" />
    <Compile Include="..\..\src\Mp3PlayerSync\LaunchHandOver.cs" Link="LaunchHandOver.cs" />
    <Compile Include="..\..\src\Mp3PlayerSync\VolumeChangeFilter.cs" Link="VolumeChangeFilter.cs" />
    <Compile Include="..\..\src\Mp3PlayerSync\RerunningCheck.cs" Link="RerunningCheck.cs" />
    <Compile Include="..\..\src\Mp3PlayerSync\HostNavigations.cs" Link="HostNavigations.cs" />
  </ItemGroup>

</Project>
