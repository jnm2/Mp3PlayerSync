<Project>
  <PropertyGroup>
    <!-- Every warning fails the build, test and publish: each is fixed or suppressed where it is, with the reason. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The lowest version builds get; the release tags decide the rest (build\Version.targets, REL-1). Raise it only
         to make the next release a minor or major one. -->
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
</Project>
