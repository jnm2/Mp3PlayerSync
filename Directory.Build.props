<Project>
  <PropertyGroup>
    <!-- Every warning fails the build, test and publish: each is fixed or suppressed where it is, with the reason. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The company is left blank, since the copyright already names the author. The SDK would otherwise fill it in
         with the authors, or with the assembly's name when there are none, so the attribute is turned off. -->
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <Authors>Joseph N. Musser II</Authors>
    <Copyright>Copyright © 2026 Joseph N. Musser II</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The patch part of this version is automatically incremented based on git tags in build\Version.targets. -->
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
</Project>
