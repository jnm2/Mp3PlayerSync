<Project>
  <PropertyGroup>
    <!-- Every warning fails the build, test and publish: each is fixed or suppressed where it is, with the reason. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Without these, the SDK uses the assembly's name as the company, which shows in each file's Properties. -->
    <Company>Joseph N. Musser II</Company>
    <Authors>Joseph N. Musser II</Authors>
    <Copyright>Copyright © 2026 Joseph N. Musser II</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The patch part of this version is automatically incremented based on git tags in build\Version.targets. -->
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
</Project>
