<Project>
  <PropertyGroup>
    <!-- Every warning fails the build, test and publish: each is fixed or suppressed where it is, with the reason. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The version builds get when a release tag doesn't set one (-p:Version in build.yml). -->
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
</Project>
