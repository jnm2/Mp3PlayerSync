<Project>
  <!-- This file sets the version of every build from the git tags, so that nobody has to bump the version by hand
       after a release (REL-1). To use it, import it from Directory.Build.targets and set VersionPrefix in
       Directory.Build.props. VersionPrefix is the lowest version that builds will get, so raise it when the next release
       should be a minor or major version.

       The SetVersionFromGitTags target runs before the SDK works out the assembly versions. It reads VersionPrefix,
       the v* tags in the repository, and the GITHUB_ACTIONS, GITHUB_REF, GITHUB_REF_NAME, GITHUB_REF_TYPE,
       GITHUB_RUN_NUMBER and GITHUB_SHA environment variables that GitHub Actions sets. It sets Version, VersionPrefix,
       InformationalVersion and, in GitHub Actions, FileVersion. If you set Version or VersionSuffix yourself, the
       target does nothing.

       A release is a GitHub Actions run for a tag, and it gets exactly the tag's version. Every other build gets a
       prerelease of the next version. If the commit is tagged, that is the tag's version. Otherwise it is the newest
       tag's version with the patch part incremented, or the same version if that tag is a prerelease. If VersionPrefix
       is higher, or there are no tags, or git isn't available, VersionPrefix is used instead.

       For example, after the v0.1.0 release the versions look like this:
         Release of v0.1.1  0.1.1+build.<run>.commit.<sha8>
         main               0.1.1-ci.<run>+commit.<sha8>
         Pull request       0.1.1-<run>.pr.<number>
         Other branch       0.1.1-<run>.<branch>
         Local build        0.1.1-dev
       In GitHub Actions the file version is the version prefix followed by the run number, such as 0.1.1.42. -->
  <Target Name="SetVersionFromGitTags" BeforeTargets="GetAssemblyVersion" Condition="'$(Version)' == '$(VersionPrefix)'">
    <!-- The 2>nul hides git's errors, so that without git or a repository the output is empty and VersionPrefix is
         used. -->
    <Exec Command="git tag --list v* --points-at HEAD --sort=-v:refname 2&gt;nul" WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_HeadTags" />
    </Exec>
    <Exec Command="git tag --list v* --sort=-v:refname 2&gt;nul" WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_Tags" />
    </Exec>

    <PropertyGroup>
      <!-- This pattern matches the same versions that build.yml accepts as release tags. The lists of tags from git are
           sorted newest first and separated by semicolons. -->
      <_VersionTagPattern>(?&lt;=^|;)v(\d+)\.(\d+)\.(\d+)(-[0-9A-Za-z.-]+)?(?=;|$)</_VersionTagPattern>
      <_HeadTag>$([System.Text.RegularExpressions.Regex]::Match('$(_HeadTags)', '$(_VersionTagPattern)'))</_HeadTag>
      <_LatestTag>$([System.Text.RegularExpressions.Regex]::Match('$(_Tags)', '$(_VersionTagPattern)'))</_LatestTag>

      <_TagVersionPrefix>0.0.0</_TagVersionPrefix>
      <_TagVersionPrefix Condition="'$(_LatestTag)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_LatestTag)', '^v(\d+)\.(\d+)\.(\d+).*$', '$1.$2.$3'))</_TagVersionPrefix>
      <_TagVersionPrefix Condition="'$(_LatestTag)' != '' and !$(_LatestTag.Contains('-'))">$([System.Text.RegularExpressions.Regex]::Replace('$(_LatestTag)', '^v(\d+)\.(\d+)\.(\d+).*$', '$1.$2')).$([MSBuild]::Add($([System.Text.RegularExpressions.Regex]::Replace('$(_LatestTag)', '^v\d+\.\d+\.(\d+).*$', '$1')), 1))</_TagVersionPrefix>
      <_TagVersionPrefix Condition="'$(_HeadTag)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_HeadTag)', '^v(\d+)\.(\d+)\.(\d+).*$', '$1.$2.$3'))</_TagVersionPrefix>
      <VersionPrefix Condition="$([MSBuild]::VersionGreaterThan('$(_TagVersionPrefix)', '$(VersionPrefix)'))">$(_TagVersionPrefix)</VersionPrefix>

      <_IsRelease>false</_IsRelease>
      <_IsRelease Condition="'$(GITHUB_ACTIONS)' == 'true' and '$(GITHUB_REF_TYPE)' == 'tag'">true</_IsRelease>
      <_PullRequest>$([System.Text.RegularExpressions.Regex]::Match('$(GITHUB_REF)', '(?&lt;=^refs/pull/)\d+'))</_PullRequest>
      <_ShortCommit Condition="'$(GITHUB_SHA)' != ''">$(GITHUB_SHA.Substring(0, 8))</_ShortCommit>
    </PropertyGroup>

    <Error Condition="$(_IsRelease) and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(GITHUB_REF_NAME)', '^v\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?$'))"
           Text="Tag '$(GITHUB_REF_NAME)' isn't a version like v1.2.3 or v1.2.3-beta.1" />

    <PropertyGroup Condition="$(_IsRelease)">
      <Version>$(GITHUB_REF_NAME.Substring(1))</Version>
      <VersionPrefix>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+'))</VersionPrefix>
      <InformationalVersion>$(Version)+build.$(GITHUB_RUN_NUMBER).commit.$(_ShortCommit)</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup Condition="!$(_IsRelease) and '$(GITHUB_ACTIONS)' == 'true' and '$(_PullRequest)' != ''">
      <Version>$(VersionPrefix)-$(GITHUB_RUN_NUMBER).pr.$(_PullRequest)</Version>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup Condition="!$(_IsRelease) and '$(GITHUB_ACTIONS)' == 'true' and '$(_PullRequest)' == '' and '$(GITHUB_REF_NAME)' == 'main'">
      <Version>$(VersionPrefix)-ci.$(GITHUB_RUN_NUMBER)</Version>
      <InformationalVersion>$(Version)+commit.$(_ShortCommit)</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup Condition="!$(_IsRelease) and '$(GITHUB_ACTIONS)' == 'true' and '$(_PullRequest)' == '' and '$(GITHUB_REF_NAME)' != 'main'">
      <Version>$(VersionPrefix)-$(GITHUB_RUN_NUMBER).$([System.Text.RegularExpressions.Regex]::Replace('$(GITHUB_REF_NAME)', '[^a-zA-Z0-9]+', '-'))</Version>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' != 'true'">
      <Version>$(VersionPrefix)-dev</Version>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>

    <PropertyGroup>
      <FileVersion Condition="'$(GITHUB_ACTIONS)' == 'true'">$(VersionPrefix).$(GITHUB_RUN_NUMBER)</FileVersion>
      <!-- The versions above already include the commit where it's wanted, so the SDK shouldn't add it again. -->
      <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
